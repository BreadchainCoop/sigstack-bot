#!/usr/bin/env sh

# Lint every commit about to be pushed (blocks non-conventional messages).
# Range: remote tip..local tip; for new branches, commits not on origin/main.

z40=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    # Branch deleted — nothing to lint
    continue
  fi

  if [ "$remote_sha" = "$z40" ]; then
    # New remote branch: lint commits not already on origin/main (or main)
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base="$(git merge-base "$local_sha" origin/main)"
    elif git rev-parse --verify main >/dev/null 2>&1; then
      base="$(git merge-base "$local_sha" main)"
    else
      base="$(git rev-list --max-parents=0 "$local_sha")"
    fi
    from="$base"
  else
    from="$remote_sha"
  fi

  echo "commitlint: checking commits $from..$local_sha"
  npx --no -- commitlint --from "$from" --to "$local_sha" --verbose
done
