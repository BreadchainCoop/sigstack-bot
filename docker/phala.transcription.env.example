# Phala transcription CVM env — copy to phala.transcription.env (do not commit secrets).
#
#   phala deploy … -c docker/phala.transcription.yaml -e docker/phala.transcription.env --wait -t tdx.medium

SIGNAL_PHONE=+1XXXXXXXXXX
# Translation bot E.164 — required for auto-accepting group invites from the hub.
PEER_PHONE=+1YYYYYYYYYY

SIGNAL_BOT_IMAGE=YOUR_DOCKERHUB/signal-bot-tee:latest
WHISPER_IMAGE=YOUR_DOCKERHUB/signal-whisper-api:latest
SIGNAL_PROXY_IMAGE=YOUR_DOCKERHUB/signal-registration-proxy:latest

WHISPER_MODEL=small
WHISPER_TIMEOUT=120s
LOG_LEVEL=info
BOT_GITHUB_REPO=https://github.com/BreadchainCoop/sigstack-bot
RATE_LIMIT_GLOBAL_PER_MINUTE=10
RATE_LIMIT_PER_NUMBER_PER_HOUR=3
# Optional: inject an ops SSH pubkey so `phala ssh -i …` works without the account ssh-keys API.
# DSTACK_AUTHORIZED_KEYS=ssh-ed25519 AAAA...
