# Copy to site/.env (gitignored). Never commit real tokens or secrets.
# Public only — safe for GitHub Pages. Server Stripe secrets belong in docker/.env.

# Alpha / checkout success “Message Sigstack” button.
# Paste the token from !bot-username (second line) or startup logs (`username_token`).
# Site assembles https://signal.me/#eu/<token> — do not put a full URL or E.164 here
# (# breaks unquoted .env).
PUBLIC_SIGNAL_USERNAME_TOKEN=YOUR_USERNAME_TOKEN_HERE

# Checkout success “Manage billing” link (Stripe Customer Portal). Optional.
# If unset, the success page shows a “coming soon” stub.
# PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_...

# signal-commerce public base (Plans Subscribe CTAs). No trailing slash.
# Local: http://localhost:8082
# Phala: https://<app-id>-8082.dstack-pha-prod9.phala.network
# PUBLIC_COMMERCE_API_BASE_URL=http://localhost:8082
