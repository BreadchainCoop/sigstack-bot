# Copy to docker/.env and fill in.
# Unified Sigstack (hub + voice + translation).

SIGNAL_PHONE=+1YYYYYYYYYY
NEAR_AI_API_KEY=sk-your-api-key-here
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
NEAR_AI_TIMEOUT=120s
WHISPER_MODEL=openai/whisper-large-v3
WHISPER_TIMEOUT=120s
TRANSLATE_ALL_ENABLED=true
TRANSLATE_ALL_MAX_MESSAGES_PER_MINUTE=30
LOG_LEVEL=info
GROUP_PREFERENCES_PERSIST=true
# Local commerce outside TEE: set false (in-memory). Persist=true needs dstack DeriveKey (Phala).
ENTITLEMENTS_PERSIST=true
# Local default off. Phala: ENTITLEMENTS_ENFORCE in .phala.env (false until E2E checklist green).
ENTITLEMENTS_ENFORCE=false
BOT_GITHUB_REPO=https://github.com/BreadchainCoop/sigstack-bot
BOT_SIGNAL_USERNAME=sigstack
RATE_LIMIT_GLOBAL_PER_MINUTE=10
RATE_LIMIT_PER_NUMBER_PER_HOUR=3

# Commerce sidecar (signal-commerce). Copy to docker/.env and fill in.
# Never commit real secrets. Site/public keys do NOT go here — see site/.env.example.

# Required to seed catalog + create Checkout Sessions (Dashboard → Test mode → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Required for webhook fulfillment (Dashboard → Developers → Webhooks → signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Required for Checkout after seed (public IDs from npm run stripe:seed-catalog -- --write-docs)
# Values are Stripe Price IDs (price_…), not dollar amounts or cents.
# Seed sets unit_amount in cents on the Price: $10.00 → 1000, $25.00 → 2500.
STRIPE_PRICE_ALL_ACCESS_3=price_...   # all-access-3 · $10.00/mo
STRIPE_PRICE_ALL_ACCESS_10=price_...  # all-access-10 · $25.00/mo

# Success/cancel redirect base + CORS for checkout create (local site or Pages)
SITE_PUBLIC_BASE_URL=http://localhost:5173
SITE_CORS_ORIGIN=http://localhost:5173

# Optional: only if migrating an old entitlements.enc compose hash
# ENTITLEMENTS_LEGACY_COMPOSE_HASH=
