# Phala one-CVM env — copy to docker/.phala.env (do not commit secrets).
#
# Upgrade live: phala deploy --cvm-id 0e82fa77-8b15-4dbd-89c4-9045ab911353 \
#   -c docker/phala.yaml -e docker/.phala.env --wait
#
# SIGNAL_PHONE = the registered bot number on this CVM.

SIGNAL_PHONE=+1YYYYYYYYYY

SIGNAL_BOT_IMAGE=YOUR_DOCKERHUB/signal-bot-tee:latest
SIGNAL_PROXY_IMAGE=YOUR_DOCKERHUB/signal-registration-proxy:latest
SIGNAL_COMMERCE_IMAGE=YOUR_DOCKERHUB/signal-commerce:latest

NEAR_AI_API_KEY=sk-your-api-key-here
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
NEAR_AI_TIMEOUT=120s

WHISPER_MODEL=openai/whisper-large-v3
WHISPER_TIMEOUT=120s

TRANSLATE_ALL_ENABLED=true
TRANSLATE_ALL_MAX_MESSAGES_PER_MINUTE=30
# Previous dstack compose_hash so group_prefs.enc / entitlements.enc still decrypt
# after an image bump when DeriveKey is unavailable. The bot then re-saves with
# an app-id-only key.
# GROUP_PREFERENCES_LEGACY_COMPOSE_HASH=
# ENTITLEMENTS_LEGACY_COMPOSE_HASH=
# Phala compose sets ENTITLEMENTS__ENFORCE=true (link + enable-sigstack gate).
LOG_LEVEL=info
BOT_GITHUB_REPO=https://github.com/BreadchainCoop/sigstack-bot
BOT_SIGNAL_USERNAME=sigstack
RATE_LIMIT_GLOBAL_PER_MINUTE=10
RATE_LIMIT_PER_NUMBER_PER_HOUR=3

# Commerce (Stripe) — never commit real secrets
# STRIPE_SECRET_KEY=rk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ALL_ACCESS_3=price_...
# STRIPE_PRICE_ALL_ACCESS_10=price_...
# SITE_PUBLIC_BASE_URL=https://breadchaincoop.github.io/sigstack-bot/sigstack
# SITE_CORS_ORIGIN=https://breadchaincoop.github.io
# After deploy, point Stripe Dashboard webhook to:
#   https://<app-id>-8082.dstack-….phala.network/v1/webhooks/stripe
# See docs/plans/2026-09-22-stripe-cvm-commerce-sidecar.md

# Optional: inject an ops SSH pubkey so `phala ssh -i …` works.
# DSTACK_AUTHORIZED_KEYS=ssh-ed25519 AAAA...